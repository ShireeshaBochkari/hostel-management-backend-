      "name": "findByReceiver_IdOrderByCreatedAtAsc",
      "signature": "public abstract java.util.List<com.hostel.hostel_management.entity.Message> com.hostel.hostel_management.repository.MessageRepository.findByReceiver_IdOrderByCreatedAtAsc(java.lang.Long)",
      "query": {
        "query": "SELECT m FROM Message m WHERE m.receiver.id = :receiverId ORDER BY m.createdAt asc"
      }
    },
    {
      "name": "findBySender_IdOrReceiver_IdOrderByCreatedAtAsc",
      "signature": "public abstract java.util.List<com.hostel.hostel_management.entity.Message> com.hostel.hostel_management.repository.MessageRepository.findBySender_IdOrReceiver_IdOrderByCreatedAtAsc(java.lang.Long,java.lang.Long)",
      "query": {
        "query": "SELECT m FROM Message m WHERE m.sender.id = :senderId OR m.receiver.id = :receiverId ORDER BY m.createdAt asc"
      }
